NODE_ENV=development
PORT=3000
APP_NAME=MyApp
APP_URL=http://localhost:3000

DATABASE_URL=postgres://app:app@localhost:5432/authdb
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-1
JWT_MFA_SECRET=change-me-change-me-change-me-change-me-2
HASH_PEPPER=change-me-change-me-change-me-change-me-3
# Exactly 32 bytes, base64. Generate with: openssl rand -base64 32
MFA_ENC_KEY=

ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
MFA_CHALLENGE_TTL_SECONDS=300

# Email (leave SMTP_HOST empty in dev to log emails to the console)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyApp <no-reply@myapp.local>"

# SMS via Twilio (leave empty in dev to log SMS to the console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
